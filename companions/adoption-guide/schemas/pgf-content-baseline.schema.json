{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pgf-content-baseline.schema.json",
  "type": "object",
  "required": [
    "baseline_release",
    "content_commit",
    "scope",
    "files"
  ],
  "properties": {
    "baseline_release": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "PGF 1.0.0"
      ]
    },
    "content_commit": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "8ac8026aec3620f84c3046f2e13b2d747d321f57"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^PGF/[0-9]{2}_[A-Za-z0-9_]+\\.md$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
